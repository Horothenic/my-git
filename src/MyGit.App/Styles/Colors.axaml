<!--
  Every color in the app comes from here. Views use {DynamicResource ...Brush}
  so switching between Dark and Light updates everything at once.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E2227" />
      <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#24292F" />
      <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#2D333B" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#22272E" />
      <SolidColorBrush x:Key="BorderBrush" Color="#373E47" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9DA7B3" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7781" />
      <SolidColorBrush x:Key="AccentBrush" Color="#4493F8" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1B3354" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F47067" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#57AB5A" />
      <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3D2E00" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#E3B341" />
      <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#4493F8" />
      <SolidColorBrush x:Key="BadgeTextBrush" Color="#0D1117" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F6F8FA" />
      <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#EAEEF2" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F6F8FA" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59636E" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#818B98" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#DDF4FF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#CF222E" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
      <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8C5" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#7D4E00" />
      <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFF" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
