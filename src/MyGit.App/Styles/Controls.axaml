<!--
  Shared control styles. Use them in views with Classes="...", for example:
  <Button Classes="toolbar-dropdown"> or <TextBlock Classes="caption">.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Toolbar: wide dropdown buttons (Repository, Branch) -->
  <Style Selector="Button.toolbar-dropdown">
    <Setter Property="Width" Value="230" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Toolbar: square icon buttons (Fetch, Pull, Push) -->
  <Style Selector="Button.toolbar-icon">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.toolbar-dropdown:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.toolbar-dropdown:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   Button.toolbar-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Small count bubble on Pull / Push -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rows inside dropdown lists -->
  <Style Selector="Button.list-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.list-row.current">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- Clone checklist rows -->
  <Style Selector="TextBlock.active">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.pending">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Small grey label, e.g. "cloned" -->
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Round profile picture / initial -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Compact tabs (clone dialog and others) -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <!-- Main window tabs: Changes / History / Stacks, stretched across the window -->
  <Style Selector="TabControl.main-tabs TabItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TabControl.main-tabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
  </Style>
  <Style Selector="TabControl.main-tabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TabControl.main-tabs TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
  </Style>
  <Style Selector="TabControl.main-tabs TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Number of changed files on the Changes tab -->
  <Style Selector="Border.tab-count">
    <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tab-count > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Placeholder for features that land in a later phase -->
  <Style Selector="Border.placeholder">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="16" />
  </Style>
  <!-- ===== Changes tab ===== -->

  <!-- Header bar above each file list and the diff -->
  <Style Selector="Border.list-header">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- Small buttons in those headers: Stage all, eye, tree/flat -->
  <Style Selector="Button.header-button">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.header-button.on">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Compact file trees -->
  <Style Selector="TreeView.files TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- M / A / D / ? / ! letters -->
  <Style Selector="TextBlock.status-letter">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Width" Value="14" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="TextBlock.status-letter.added">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.status-letter.deleted">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.status-letter.conflicted">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Diff list: rows edge to edge, no selection highlight -->
  <Style Selector="ListBox.diff">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.diff ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.diff ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.hunk-header">
    <Setter Property="Background" Value="{DynamicResource HunkHeaderBrush}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="TextBlock.hunk-title">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource HunkHeaderTextBrush}" />
  </Style>

  <Style Selector="Border.diff-side.removed">
    <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
  </Style>
  <Style Selector="Border.diff-side.added">
    <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
  </Style>
  <Style Selector="Border.diff-side.empty">
    <Setter Property="Background" Value="{DynamicResource DiffEmptyBrush}" />
  </Style>

  <!-- A picked line: blue outline, thicker on the left -->
  <Style Selector="Border.diff-side">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>
  <Style Selector="Border.diff-side.removed, Border.diff-side.added">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.diff-side.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Bar under the diff while lines are picked -->
  <Style Selector="Border.selection-bar">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="TextBlock.line-number">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Padding" Value="0,1,10,1" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="0,1,8,1" />
  </Style>

  <!-- Splitters: a quiet line you can still grab -->
  <Style Selector="GridSplitter.thin">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="GridSplitter.thin:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- Green "Committed …" strip under the commit box -->
  <Style Selector="Border.commit-done">
    <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <!-- Command palette -->
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>
  <Style Selector="Border.key">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- An icon button that throws work away (Discard all) -->
  <Style Selector="Button.danger-icon:pointerover mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Text-only button, e.g. Undo -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Spinning icon while something runs -->
  <Style Selector="mi|MaterialIcon.spin">
    <Setter Property="RenderTransform">
      <RotateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Pull request button and badges: green open, gray draft, purple merged, red closed -->
  <Style Selector="Button.pr-button.open">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.pr-badge.open TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Button.pr-button.draft">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.pr-badge.draft TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.pr-button.merged">
    <Setter Property="Foreground" Value="{DynamicResource MergedBrush}" />
  </Style>
  <Style Selector="Border.pr-badge.merged TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MergedBrush}" />
  </Style>
  <Style Selector="Button.pr-button.closed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.pr-badge.closed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.pr-badge">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pr-badge TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- Status bar at the bottom: a stopped rebase / merge / cherry-pick / revert, and messages -->
  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.status-bar.success">
    <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Button.status-button">
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Built-in conflict resolver (VS Code style) -->
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.conflict-header">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.conflict-block">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Border.conflict-block.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.lens">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.lens:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.conflict-result">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Conflicts header -->
  <Style Selector="Border.conflicts-header">
    <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
  </Style>

  <!-- Stashes section in the Changes tab -->
  <Style Selector="ListBox.stashes, ListBox.stash-files">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.stashes ListBoxItem, ListBox.stash-files ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ToggleButton.expander-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ToggleButton.expander-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Reset dialog choices -->
  <Style Selector="Border.reset-option">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- ===== History tab ===== -->

  <Style Selector="ListBox.commits, ListBox.commit-files">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.commits ListBoxItem, ListBox.commit-files ListBoxItem">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.commit-files ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- Branch / tag / HEAD labels on commits -->
  <Style Selector="Border.ref">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ref TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.ref.local">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.ref.local TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.ref.remote">
    <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.ref.remote TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.ref.tag">
    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Border.ref.tag TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Border.ref.tag mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Border.ref.head">
    <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.ref.head TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Red button for destructive confirmations -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
</Styles>
