<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyGit.App.ViewModels.Changes"
             xmlns:views="using:MyGit.App.Views"
             xmlns:changes="using:MyGit.Core.Changes"
             xmlns:ops="using:MyGit.Core.Operations"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MyGit.App.Views.ChangesView"
             x:DataType="vm:ChangesViewModel">

  <UserControl.Styles>
    <!-- Folders open or closed as the view model says (and remember it across refreshes). -->
    <Style Selector="TreeView.files TreeViewItem" x:DataType="vm:FileTreeNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One row in either file tree -->
    <TreeDataTemplate x:Key="FileNodeTemplate" DataType="vm:FileTreeNodeViewModel" ItemsSource="{Binding Children}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
        <Panel Grid.Column="0" Width="16" VerticalAlignment="Center">
          <mi:MaterialIcon Kind="FolderOutline" Width="15" Height="15" IsVisible="{Binding IsFolder}" />
          <mi:MaterialIcon Kind="FileOutline" Width="15" Height="15" IsVisible="{Binding IsFile}" />
        </Panel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding FileCount, StringFormat='({0})'}" IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="status-letter" Text="{Binding Letter}"
                   Classes.added="{Binding IsAdded}" Classes.deleted="{Binding IsDeleted}" Classes.conflicted="{Binding IsConflicted}" />
      </Grid>
    </TreeDataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="320,4,*">

    <!-- ===== Left: Unstaged and Staged trees ===== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,4,Auto,*,Auto">

      <!-- Conflicts: only while a rebase, merge, cherry-pick or revert is stopped -->
      <StackPanel Grid.Row="0" IsVisible="{Binding HasConflicts}">
        <Border Classes="list-header conflicts-header">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="AlertOutline" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock FontWeight="SemiBold" Text="Conflicts" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding ConflictCount}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ListBox x:Name="ConflictList" Classes="stash-files" ItemsSource="{Binding ConflictFiles}"
                 SelectedItem="{Binding SelectedConflict}" MaxHeight="180">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="changes:FileChange">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding Path}">
                <mi:MaterialIcon Grid.Column="0" Kind="FileAlertOutline" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="status-letter conflicted" Text="!" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- Unstaged header -->
      <Border Grid.Row="1" Classes="list-header">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <Button Classes="header-button" Command="{Binding ToggleHiddenViewCommand}"
                    Classes.on="{Binding IsShowingHidden}"
                    ToolTip.Tip="Show hidden files (Ctrl+H). Select files and press H to hide or unhide them.">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <mi:MaterialIcon Kind="EyeOffOutline" Width="14" Height="14" IsVisible="{Binding IsShowingChanges}" />
                <mi:MaterialIcon Kind="EyeOutline" Width="14" Height="14" IsVisible="{Binding IsShowingHidden}" />
                <TextBlock Text="{Binding HiddenCount}" />
              </StackPanel>
            </Button>
            <Button Classes="header-button" Command="{Binding ToggleFlatCommand}" ToolTip.Tip="Folder tree or flat list">
              <Panel>
                <mi:MaterialIcon Kind="FileTreeOutline" Width="14" Height="14" IsVisible="{Binding !IsFlat}" />
                <mi:MaterialIcon Kind="FormatListBulleted" Width="14" Height="14" IsVisible="{Binding IsFlat}" />
              </Panel>
            </Button>
            <Button x:Name="StashButton" Classes="header-button" IsVisible="{Binding IsShowingChanges}"
                    ToolTip.Tip="Put your uncommitted changes aside (select files first to stash only those)">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="14" Height="14" />
                <TextBlock Text="Stash…" />
              </StackPanel>
            </Button>
            <Button Classes="header-button" Content="Stage all" Command="{Binding StageAllCommand}"
                    IsVisible="{Binding IsShowingChanges}" ToolTip.Tip="Stage every file shown (hidden files are skipped)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding UnstagedTitle}" />
            <TextBlock Classes="caption" Text="{Binding UnstagedCount}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel Grid.Row="2">
        <TreeView x:Name="UnstagedTree" Classes="files" SelectionMode="Multiple"
                  ItemsSource="{Binding Unstaged.Roots}" ItemTemplate="{StaticResource FileNodeTemplate}">
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="UnstagedStageItem" Header="Stage" InputGesture="Enter" />
              <MenuItem x:Name="UnstagedDiscardItem" Header="Discard changes…" InputGesture="Delete" />
              <MenuItem x:Name="UnstagedHideItem" Header="Hide" InputGesture="H" />
              <Separator />
              <MenuItem x:Name="UnstagedOpenItem" Header="Open in editor" />
              <MenuItem x:Name="UnstagedExplorerItem" Header="Show in Explorer" />
              <MenuItem x:Name="UnstagedCopyItem" Header="Copy path" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
        <TextBlock Classes="caption" Text="{Binding UnstagedEmptyText}" IsVisible="{Binding IsUnstagedEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="16" />
      </Panel>

      <GridSplitter Grid.Row="3" ResizeDirection="Rows" Classes="thin" />

      <!-- Staged header -->
      <Border Grid.Row="4" Classes="list-header">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="header-button" Content="Unstage all" Command="{Binding UnstageAllCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="Staged" />
            <TextBlock Classes="caption" Text="{Binding StagedCount}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel Grid.Row="5">
        <TreeView x:Name="StagedTree" Classes="files" SelectionMode="Multiple"
                  ItemsSource="{Binding Staged.Roots}" ItemTemplate="{StaticResource FileNodeTemplate}">
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="StagedUnstageItem" Header="Unstage" InputGesture="Enter" />
              <Separator />
              <MenuItem x:Name="StagedOpenItem" Header="Open in editor" />
              <MenuItem x:Name="StagedExplorerItem" Header="Show in Explorer" />
              <MenuItem x:Name="StagedCopyItem" Header="Copy path" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
        <TextBlock Classes="caption" Text="Select files above and press Enter to stage them." IsVisible="{Binding IsStagedEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="16" />
      </Panel>

      <!-- Stashes: changes put aside. Select one to see its files; right-click to apply, pop or delete. -->
      <StackPanel Grid.Row="6" IsVisible="{Binding HasStashes}">
        <Border Classes="list-header" BorderThickness="0,1,0,1">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Left" Classes="expander-toggle" IsChecked="{Binding IsStashesExpanded}" Margin="0,0,6,0">
              <Panel>
                <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding IsStashesExpanded}" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" IsVisible="{Binding !IsStashesExpanded}" />
              </Panel>
            </ToggleButton>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="Stashes" />
              <TextBlock Classes="caption" Text="{Binding StashCount}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <StackPanel IsVisible="{Binding IsStashesExpanded}">
          <ListBox Classes="stashes" ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash}" MaxHeight="150">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StashItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Apply (keep the stash)" Command="{Binding ApplyCommand}" />
                      <MenuItem Header="Pop (apply and remove)" Command="{Binding PopCommand}" />
                      <Separator />
                      <MenuItem Header="Delete…" Command="{Binding DropCommand}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <mi:MaterialIcon Grid.Column="0" Kind="ArchiveOutline" Width="14" Height="14" />
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Details}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Files of the selected stash: click one to see its diff (read-only). -->
          <ListBox x:Name="StashFilesList" Classes="stash-files" ItemsSource="{Binding StashFiles}" SelectedItem="{Binding SelectedStashFile}"
                   MaxHeight="150" IsVisible="{Binding HasSelectedStash}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="changes:FileChange">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="18,0,0,0" ToolTip.Tip="{Binding Path}">
                  <mi:MaterialIcon Grid.Column="0" Kind="FileOutline" Width="14" Height="14" />
                  <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="status-letter" Text="{Binding Letter}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Classes="thin" />

    <!-- ===== Right: diff and commit box ===== -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,4,Auto">

      <!-- Diff header -->
      <Border Grid.Row="0" Classes="list-header" IsVisible="{Binding Diff.HasFile}" IsEnabled="{Binding IsDiffShown}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <Button Classes="header-button" Content="Discard file" Command="{Binding DiscardShownFileCommand}"
                    IsVisible="{Binding Diff.ShowUnstagedActions}" />
            <Button Classes="header-button" Content="Stage file" Command="{Binding StageShownFileCommand}"
                    IsVisible="{Binding Diff.ShowUnstagedActions}" />
            <Button Classes="header-button" Content="Unstage file" Command="{Binding StageShownFileCommand}"
                    IsVisible="{Binding Diff.ShowStagedActions}" />
          </StackPanel>
          <SelectableTextBlock FontWeight="SemiBold" Text="{Binding Diff.Title}" VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Diff body (shared with the History tab) -->
      <Panel Grid.Row="1" IsVisible="{Binding IsDiffShown}">
        <views:DiffView DataContext="{Binding Diff}" />
      </Panel>

      <!-- Selected conflict: resolve the whole file -->
      <DockPanel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsConflictSelected}" Background="{DynamicResource WindowBackgroundBrush}">
        <Border DockPanel.Dock="Top" Classes="list-header">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Right" ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding IsNotRunningTool}">
              <Button Classes="header-button" Content="{Binding UseOursText}" Command="{Binding UseOursCommand}" ToolTip.Tip="{Binding OursLabel}" />
              <Button Classes="header-button" Content="{Binding UseTheirsText}" Command="{Binding UseTheirsCommand}" ToolTip.Tip="{Binding TheirsLabel}" />
              <Button Classes="header-button" Command="{Binding OpenConflictInDefaultAppCommand}"
                      ToolTip.Tip="Open with the program Windows uses for this file type. Then Mark resolved.">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <mi:MaterialIcon Kind="OpenInNew" Width="12" Height="12" />
                  <TextBlock Text="Open in default app" />
                </StackPanel>
              </Button>
              <Button Classes="header-button" IsVisible="{Binding HasMergeTools}" ToolTip.Tip="Resolve it in a merge tool">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Merge tool" />
                  <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout ItemsSource="{Binding MergeTools}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="ops:MergeTool">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:ChangesViewModel)DataContext).RunMergeToolCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="header-button" Content="Mark resolved" Command="{Binding MarkResolvedCommand}"
                      ToolTip.Tip="You fixed it yourself (no conflict markers left)" />
            </WrapPanel>
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedConflict.Path}" VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
          </DockPanel>
        </Border>

        <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520" Margin="24"
                    IsVisible="{Binding !Resolver.IsActive}">
          <mi:MaterialIcon Kind="SourceMerge" Width="32" Height="32" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Classes="caption" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsNotRunningTool}"
                     Text="This file was changed on both sides. Keep one side with the buttons above, resolve it in a merge tool, or open it in your editor and then Mark resolved." />
          <TextBlock FontSize="13" TextAlignment="Center" Text="{Binding RunningTool}" IsVisible="{Binding !IsNotRunningTool}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding OursExplanation}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding TheirsExplanation}" />
        </StackPanel>
        <!-- Built-in resolver: both sides of the current conflict, the choice bar, and the editable result -->
        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding Resolver.IsActive}">
          <Grid Grid.Row="0" ColumnDefinitions="*,1,*" MinHeight="90" MaxHeight="220">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="10,6" Text="{Binding Resolver.OursLabel}" TextTrimming="CharacterEllipsis" />
              <ScrollViewer>
                <SelectableTextBlock Classes="conflict-side ours" Text="{Binding Resolver.CurrentOursText}" />
              </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="10,6" Text="{Binding Resolver.TheirsLabel}" TextTrimming="CharacterEllipsis" />
              <ScrollViewer>
                <SelectableTextBlock Classes="conflict-side theirs" Text="{Binding Resolver.CurrentTheirsText}" />
              </ScrollViewer>
            </DockPanel>
          </Grid>

          <Border Grid.Row="1" Classes="selection-bar" BorderThickness="0,1,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Classes="header-button" Content="{Binding Resolver.TakeOursText}" Command="{Binding Resolver.TakeOursCommand}" />
                <Button Classes="header-button" Content="{Binding Resolver.TakeTheirsText}" Command="{Binding Resolver.TakeTheirsCommand}" />
                <Button Classes="header-button" Content="Take both" Command="{Binding Resolver.TakeBothCommand}"
                        ToolTip.Tip="Keep both: the left side's lines first, then the right side's" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="header-button" Command="{Binding Resolver.PreviousCommand}" ToolTip.Tip="Previous conflict">
                  <mi:MaterialIcon Kind="ChevronUp" Width="14" Height="14" />
                </Button>
                <Button Classes="header-button" Command="{Binding Resolver.NextCommand}" ToolTip.Tip="Next conflict">
                  <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                </Button>
                <TextBlock Text="{Binding Resolver.PositionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>

          <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="10,6"
                       Text="Result (what will be saved). You can edit it; taking a side rebuilds it from your choices." />
            <TextBox Classes="conflict-result" Text="{Binding Resolver.ResultText}" AcceptsReturn="True" AcceptsTab="True" />
          </DockPanel>

          <Border Grid.Row="3" Classes="selection-bar">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="accent" Content="Save and mark resolved" Command="{Binding Resolver.SaveCommand}" />
              <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="Undecided conflicts keep their markers, and the file stays under Conflicts until they're gone." />
            </DockPanel>
          </Border>
        </Grid>
        </Panel>
      </DockPanel>

      <GridSplitter Grid.Row="2" ResizeDirection="Rows" Classes="thin" />

      <!-- While a rebase / merge / cherry-pick / revert is stopped, Continue commits instead -->
      <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" Padding="14,12" IsVisible="{Binding IsOperationActive}">
        <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                   Text="Resolve the conflicts, then press Continue in the yellow bar above: it commits the resolved files and goes on. No need to commit here." />
      </Border>

      <!-- Commit box, plus the confirmation strip for the commit just made -->
      <StackPanel Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" IsVisible="{Binding IsCommitBoxVisible}">
        <StackPanel Spacing="8" Margin="12,10">
          <TextBox x:Name="SummaryBox" PlaceholderText="Summary (required)" Text="{Binding Summary}" MaxLength="200"
                   IsEnabled="{Binding IsNotCommitting}" />
          <TextBox PlaceholderText="Description" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="60" MaxHeight="200" IsEnabled="{Binding IsNotCommitting}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding CommitCommand}" ToolTip.Tip="Ctrl+Enter">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Loading" Width="14" Height="14" Classes="spin" IsVisible="{Binding IsCommitting}" />
                <TextBlock Text="{Binding CommitButtonText}" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <CheckBox Content="Amend last commit" IsChecked="{Binding IsAmend}" IsEnabled="{Binding IsNotCommitting}" />
              <TextBlock Classes="caption" Text="{Binding StagedCountText}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </StackPanel>

        <Border Classes="commit-done" IsVisible="{Binding HasLastCommit}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Command="{Binding DismissLastCommitCommand}" AutomationProperties.Name="Dismiss"
                    ToolTip.Tip="Hide this message (the commit stays)" Margin="4,0,0,0">
              <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Button>
            <Button DockPanel.Dock="Right" Classes="link" Content="Undo" Command="{Binding UndoLastCommitCommand}"
                    ToolTip.Tip="Take this commit back: its files go back to Staged and its message back into the box" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Text="{Binding LastCommitTitle}" Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Text="{Binding LastCommitDetails}" VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas, monospace" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
