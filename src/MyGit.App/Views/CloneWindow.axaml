<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyGit.App.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.CloneWindow"
        x:DataType="vm:CloneViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/my-git.ico"
        Width="560" Height="600"
        MinWidth="460" MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Panel>
  <!-- ===== Form: pick a repository and folder ===== -->
  <DockPanel IsVisible="{Binding IsForm}">

    <!-- ===== Bottom: destination and buttons ===== -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="Clone into" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding DestinationFolder}" />
          <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" />
        </Grid>
        <TextBlock Classes="caption" Text="{Binding TargetPathText}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Clone" Classes="accent" Command="{Binding CloneCommand}" IsEnabled="{Binding CanClone}" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== Tabs: your repositories / URL ===== -->
    <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">

      <TabItem Header="Your repositories">
        <Panel>
          <!-- Signed out -->
          <StackPanel IsVisible="{Binding !IsSignedIn}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="320">
            <mi:MaterialIcon Kind="Github" Width="32" Height="32" />
            <TextBlock Classes="caption" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Sign in to see your repositories. You can still clone any public repository from the URL tab." />
            <Button HorizontalAlignment="Center" Content="Sign in with GitHub" Command="{Binding SignInCommand}" />
          </StackPanel>

          <!-- Signed in -->
          <DockPanel IsVisible="{Binding IsSignedIn}" Margin="16,12,16,0">
            <TextBox DockPanel.Dock="Top" PlaceholderText="Filter repositories" Text="{Binding FilterText}" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Classes="caption" Text="Loading your repositories…" Margin="4"
                       IsVisible="{Binding IsLoadingRepositories}" />
            <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="4"
                       Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CloneRepositoryGroupViewModel">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Classes="caption" Text="{Binding Owner}" Margin="8,4" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CloneRepositoryItemViewModel">
                            <Button Classes="list-row" Classes.current="{Binding IsSelected}" Command="{Binding SelectCommand}">
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                  <mi:MaterialIcon Kind="LockOutline" Width="14" Height="14" IsVisible="{Binding IsPrivate}" />
                                  <mi:MaterialIcon Kind="Web" Width="14" Height="14" IsVisible="{Binding !IsPrivate}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="tag" IsVisible="{Binding IsCloned}">
                                  <TextBlock Text="cloned" />
                                </Border>
                                <TextBlock Grid.Column="3" Classes="caption" Text="{Binding PushedText}" VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </TabItem>

      <TabItem Header="URL">
        <StackPanel Margin="16,16" Spacing="8">
          <TextBlock Classes="caption" Text="Repository URL" />
          <TextBox PlaceholderText="https://github.com/owner/repository.git" Text="{Binding Url}" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Any https URL works. Private GitHub repositories need you to be signed in." />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>

  <!-- ===== Cloning popup: stage checklist ===== -->
  <StackPanel IsVisible="{Binding !IsForm}" Margin="20,18" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <mi:MaterialIcon Kind="CloudDownloadOutline" Width="24" Height="24" />
      <StackPanel>
        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CloningName, StringFormat='Cloning {0}'}" />
        <TextBlock Classes="caption" Text="{Binding CloningSource}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="caption" TextWrapping="Wrap">
      <Run Text="Into " />
      <Run Text="{Binding CloningTarget}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
           Foreground="{DynamicResource TextPrimaryBrush}" />
    </TextBlock>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <ItemsControl ItemsSource="{Binding Stages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CloneStageViewModel">
            <StackPanel Margin="0,4" Spacing="4">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Panel Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CheckCircleOutline" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                  <mi:MaterialIcon Kind="ProgressDownload" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}" />
                  <mi:MaterialIcon Kind="CircleOutline" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsPending}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           Classes.active="{Binding IsActive}" Classes.pending="{Binding IsPending}" />
                <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Detail}" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Margin="24,0,0,0" Height="6" Minimum="0" Maximum="100"
                           Value="{Binding Percent}" IsVisible="{Binding IsActive}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Running / stopping -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBusy}">
      <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                 Text="{Binding ElapsedText, StringFormat='Elapsed {0}'}" IsVisible="{Binding IsCloning}" />
      <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Stopping… removing the partial folder." IsVisible="{Binding IsStopping}" />
      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCloning}" />
    </Grid>

    <!-- Failed -->
    <StackPanel Spacing="8" IsVisible="{Binding IsFailed}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="Clone failed" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                 Text="{Binding CloneError, StringFormat='{}{0} The partial folder was removed.'}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}" />
        <Button Content="Try again" Classes="accent" Command="{Binding TryAgainCommand}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </Panel>
</Window>
