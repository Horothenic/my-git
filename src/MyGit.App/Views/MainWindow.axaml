<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyGit.App.ViewModels"
        xmlns:views="using:MyGit.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="My Git"
        Icon="/Assets/my-git.ico"
        Width="1280" Height="800"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- ===== Toolbar ===== -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel>

        <!-- Right side: theme + account -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
          <Button Classes="toolbar-icon" BorderThickness="0"
                  Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="Switch theme"
                  ToolTip.Tip="Switch dark / light theme">
            <mi:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" />
          </Button>
          <!-- Account button and menu -->
          <Button x:Name="AccountButton" Classes="toolbar-icon" BorderThickness="0" Width="NaN" Padding="10,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel VerticalAlignment="Center">
                <mi:MaterialIcon Kind="AccountCircleOutline" Width="22" Height="22"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 IsVisible="{Binding Account.IsSignedOut}" />
                <Border Classes="avatar" IsVisible="{Binding Account.IsSignedIn}">
                  <Panel>
                    <TextBlock Text="{Binding Account.Initial}" IsVisible="{Binding !Account.HasAvatar}" />
                    <Image Source="{Binding Account.Avatar}" IsVisible="{Binding Account.HasAvatar}" />
                  </Panel>
                </Border>
              </Panel>
              <TextBlock Text="{Binding Account.DisplayName}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Panel x:DataType="vm:MainWindowViewModel" Width="280">

                  <!-- Signed out -->
                  <StackPanel Spacing="8" IsVisible="{Binding Account.IsSignedOut}">
                    <TextBlock FontWeight="SemiBold" Text="Sign in to GitHub" />
                    <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                               Text="One account for all your repositories. Used for clone, fetch, pull and push." />
                    <Button Command="{Binding Account.SignInCommand}" Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Github" Width="16" Height="16" />
                        <TextBlock Text="Sign in with GitHub" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Signed in -->
                  <StackPanel Spacing="4" IsVisible="{Binding Account.IsSignedIn}">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,8">
                      <Border Classes="avatar" Width="36" Height="36" CornerRadius="18">
                        <Panel>
                          <TextBlock Text="{Binding Account.Initial}" IsVisible="{Binding !Account.HasAvatar}" />
                          <Image Source="{Binding Account.Avatar}" IsVisible="{Binding Account.HasAvatar}" />
                        </Panel>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Account.DisplayName}" />
                        <TextBlock Classes="caption" Text="{Binding Account.Login, StringFormat='@{0} · github.com'}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Classes="list-row" Command="{Binding Account.ViewProfileCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" />
                        <TextBlock Text="View profile on GitHub" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding Account.SignOutCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Logout" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Sign out" Foreground="{DynamicResource DangerBrush}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Panel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- Left side: Repository, Branch, Fetch, Pull, Push -->
        <StackPanel Orientation="Horizontal">

          <!-- Repository dropdown -->
          <Button x:Name="RepositoryButton" Classes="toolbar-dropdown">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <mi:MaterialIcon Grid.Column="0" Kind="SourceRepository" Width="18" Height="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="Repository" />
                <TextBlock Classes="title" Text="{Binding RepositoryName}" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16" />
            </Grid>

            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel x:DataType="vm:MainWindowViewModel" Width="340" Spacing="8">
                  <TextBox PlaceholderText="Filter repositories"
                           Text="{Binding RepositoryPicker.FilterText}" />

                  <TextBlock Classes="caption" Margin="4,4"
                             IsVisible="{Binding !RepositoryPicker.HasRepositories}"
                             Text="No repositories yet. Add a local folder to start." />

                  <ScrollViewer MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding RepositoryPicker.Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryItemViewModel">
                          <Button Classes="list-row"
                                  Classes.current="{Binding IsCurrent}"
                                  Command="{Binding OpenCommand}"
                                  ToolTip.Tip="{Binding Path}">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                                <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <Panel Grid.Column="0" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="Check" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 IsVisible="{Binding IsCurrent}" />
                                <mi:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                 IsVisible="{Binding !IsCurrent}" />
                              </Panel>
                              <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Name}" />
                                  <TextBlock Text="(missing)" Foreground="{DynamicResource DangerBrush}"
                                             IsVisible="{Binding IsMissing}" />
                                </StackPanel>
                                <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding RepositoryPicker.AddLocalCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" />
                        <TextBlock Text="Add local" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding CloneCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16" />
                        <TextBlock Text="Clone" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Branch dropdown (switching arrives in Phase 5) -->
          <Button Classes="toolbar-dropdown" IsEnabled="{Binding HasRepository}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <mi:MaterialIcon Grid.Column="0" Kind="SourceBranch" Width="18" Height="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="Branch" />
                <TextBlock Classes="title" Text="{Binding BranchName}" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <TextBlock Classes="caption" Width="260" TextWrapping="Wrap"
                           Text="Switching, creating and fast-forwarding branches arrives in Phase 5." />
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Fetch / Pull / Push. Counts come from the last fetch (fetching is manual). -->
          <Button Classes="toolbar-icon" Command="{Binding Sync.FetchCommand}" AutomationProperties.Name="Fetch"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.FetchToolTip}">
            <Panel>
              <mi:MaterialIcon Kind="Refresh" Width="20" Height="20" IsVisible="{Binding !Sync.IsFetching}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsFetching}"
                               Foreground="{DynamicResource AccentBrush}" />
            </Panel>
          </Button>

          <Button Classes="toolbar-icon" Command="{Binding Sync.PullCommand}" AutomationProperties.Name="Pull"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.PullToolTip}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Pull with rebase (default)" Command="{Binding Sync.PullCommand}" />
                <MenuItem Header="Pull with merge" Command="{Binding Sync.PullWithMergeCommand}" />
                <MenuItem Header="Fast-forward only" Command="{Binding Sync.PullFastForwardOnlyCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <Panel>
              <mi:MaterialIcon Kind="ArrowDown" Width="20" Height="20" IsVisible="{Binding !Sync.IsPulling}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsPulling}"
                               Foreground="{DynamicResource AccentBrush}" />
              <Border Classes="badge" IsVisible="{Binding Sync.HasCommitsToPull}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0">
                <TextBlock Text="{Binding Sync.CommitsToPull}" />
              </Border>
            </Panel>
          </Button>

          <!-- Push, or Publish for a branch that isn't on GitHub yet -->
          <Button Classes="toolbar-icon" Command="{Binding Sync.PushCommand}" IsVisible="{Binding Sync.IsPushVisible}" AutomationProperties.Name="Push"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.PushToolTip}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Push" Command="{Binding Sync.PushCommand}" />
                <MenuItem Header="Force push (safe, with lease)…" Command="{Binding Sync.ForcePushCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <Panel>
              <mi:MaterialIcon Kind="ArrowUp" Width="20" Height="20" IsVisible="{Binding !Sync.IsPushing}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsPushing}"
                               Foreground="{DynamicResource AccentBrush}" />
              <Border Classes="badge" IsVisible="{Binding Sync.HasCommitsToPush}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0">
                <TextBlock Text="{Binding Sync.CommitsToPush}" />
              </Border>
            </Panel>
          </Button>

          <Button Classes="toolbar-icon" Width="NaN" Padding="12,0" Command="{Binding Sync.PushCommand}"
                  IsVisible="{Binding Sync.NeedsPublish}" ToolTip.Tip="{Binding Sync.PushToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="CloudUploadOutline" Width="18" Height="18" IsVisible="{Binding !Sync.IsPushing}" />
              <mi:MaterialIcon Kind="Loading" Width="18" Height="18" Classes="spin" IsVisible="{Binding Sync.IsPushing}"
                               Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Publish" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Green note after fetch / pull / push (hides by itself) ===== -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding Sync.HasNotice}"
            Background="{DynamicResource DiffAddedBrush}" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
        <TextBlock Text="{Binding Sync.Notice}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ===== Message bar ===== -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasMessage}"
            Background="{DynamicResource WarningBackgroundBrush}"
            Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Padding="4" Background="Transparent"
                Command="{Binding DismissMessageCommand}" ToolTip.Tip="Dismiss">
          <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource WarningTextBrush}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningTextBrush}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Content ===== -->
    <Panel>

      <!-- Empty state: no repository open -->
      <StackPanel IsVisible="{Binding !HasRepository}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" MaxWidth="380">
        <Image Source="/Assets/my-git-128.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Classes="heading" Text="Open a repository" HorizontalAlignment="Center" />
        <TextBlock Classes="caption" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Clone one of your GitHub repositories, or add a folder that's already a git repository." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Command="{Binding CloneCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16" />
              <TextBlock Text="Clone repository" />
            </StackPanel>
          </Button>
          <Button Command="{Binding RepositoryPicker.AddLocalCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" />
              <TextBlock Text="Add local repository" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Repository open: main tabs -->
      <!-- Full-width tabs on a toolbar-colored strip (the selected tab takes the content's color). -->
      <TabControl Classes="main-tabs" IsVisible="{Binding HasRepository}" Padding="0">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Background="{DynamicResource ToolbarBackgroundBrush}" />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="FileDocumentEditOutline" Width="16" Height="16" />
              <TextBlock Text="Changes" VerticalAlignment="Center" />
              <Border Classes="tab-count" IsVisible="{Binding Changes.HasChangedFiles}">
                <TextBlock Text="{Binding Changes.ChangedFileCount}" />
              </Border>
            </StackPanel>
          </TabItem.Header>
          <views:ChangesView DataContext="{Binding Changes}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="History" Width="16" Height="16" />
              <TextBlock Text="History" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <Border Classes="placeholder">
            <TextBlock Classes="caption" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Commit graph, tags and branch-from-commit arrive in Phase 5." />
          </Border>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="LayersOutline" Width="16" Height="16" />
              <TextBlock Text="Stacks" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <Border Classes="placeholder">
            <TextBlock Classes="caption" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Stacked pull requests arrive in Phases 10 and 11." />
          </Border>
        </TabItem>
      </TabControl>
    </Panel>
  </DockPanel>
</Window>
