<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyGit.App.ViewModels"
        xmlns:views="using:MyGit.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="My Git"
        Icon="/Assets/my-git.ico"
        Width="1280" Height="800"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding Sync.FetchCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding Sync.PullCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+U" Command="{Binding Sync.PushCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding Branches.NewBranchCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabCommand}" CommandParameter="0" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabCommand}" CommandParameter="2" />
  </Window.KeyBindings>

  <Panel>
  <DockPanel>

    <!-- ===== Toolbar ===== -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel>

        <!-- Right side: theme + account -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
          <Button Classes="toolbar-icon" BorderThickness="0"
                  Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="Switch theme"
                  ToolTip.Tip="Switch dark / light theme">
            <mi:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" />
          </Button>
          <!-- Account button and menu -->
          <Button x:Name="AccountButton" Classes="toolbar-icon" BorderThickness="0" Width="NaN" Padding="10,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel VerticalAlignment="Center">
                <mi:MaterialIcon Kind="AccountCircleOutline" Width="22" Height="22"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 IsVisible="{Binding Account.IsSignedOut}" />
                <Border Classes="avatar" IsVisible="{Binding Account.IsSignedIn}">
                  <Panel>
                    <TextBlock Text="{Binding Account.Initial}" IsVisible="{Binding !Account.HasAvatar}" />
                    <Image Source="{Binding Account.Avatar}" IsVisible="{Binding Account.HasAvatar}" />
                  </Panel>
                </Border>
              </Panel>
              <TextBlock Text="{Binding Account.DisplayName}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Panel x:DataType="vm:MainWindowViewModel" Width="280">

                  <!-- Signed out -->
                  <StackPanel Spacing="8" IsVisible="{Binding Account.IsSignedOut}">
                    <TextBlock FontWeight="SemiBold" Text="Sign in to GitHub" />
                    <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                               Text="One account for all your repositories. Used for clone, fetch, pull and push." />
                    <Button Command="{Binding Account.SignInCommand}" Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Github" Width="16" Height="16" />
                        <TextBlock Text="Sign in with GitHub" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding OpenSettingsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                        <TextBlock Text="Settings…" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding ShowShortcutsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16" />
                        <TextBlock Text="Keyboard shortcuts" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding Updates.CheckNowCommand, FallbackValue={x:Null}}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Update" Width="16" Height="16" />
                        <StackPanel>
                          <TextBlock Text="Check for updates" />
                          <TextBlock Classes="caption" Text="{Binding Updates.VersionText, FallbackValue=''}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Signed in -->
                  <StackPanel Spacing="4" IsVisible="{Binding Account.IsSignedIn}">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,8">
                      <Border Classes="avatar" Width="36" Height="36" CornerRadius="18">
                        <Panel>
                          <TextBlock Text="{Binding Account.Initial}" IsVisible="{Binding !Account.HasAvatar}" />
                          <Image Source="{Binding Account.Avatar}" IsVisible="{Binding Account.HasAvatar}" />
                        </Panel>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Account.DisplayName}" />
                        <TextBlock Classes="caption" Text="{Binding Account.Login, StringFormat='@{0} · github.com'}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Classes="list-row" Command="{Binding Account.ViewProfileCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" />
                        <TextBlock Text="View profile on GitHub" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding OpenSettingsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                        <TextBlock Text="Settings…" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding ShowShortcutsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16" />
                        <TextBlock Text="Keyboard shortcuts" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding Updates.CheckNowCommand, FallbackValue={x:Null}}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Update" Width="16" Height="16" />
                        <StackPanel>
                          <TextBlock Text="Check for updates" />
                          <TextBlock Classes="caption" Text="{Binding Updates.VersionText, FallbackValue=''}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding Account.SignOutCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Logout" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Sign out" Foreground="{DynamicResource DangerBrush}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Panel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- Left side: Repository, Branch, Fetch, Pull, Push -->
        <StackPanel Orientation="Horizontal">

          <!-- Repository dropdown -->
          <Button x:Name="RepositoryButton" Classes="toolbar-dropdown">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <mi:MaterialIcon Grid.Column="0" Kind="SourceRepository" Width="18" Height="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="Repository" />
                <TextBlock Classes="title" Text="{Binding RepositoryName}" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16" />
            </Grid>

            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel x:DataType="vm:MainWindowViewModel" Width="340" Spacing="8">
                  <TextBox PlaceholderText="Filter repositories"
                           Text="{Binding RepositoryPicker.FilterText}" />

                  <TextBlock Classes="caption" Margin="4,4"
                             IsVisible="{Binding !RepositoryPicker.HasRepositories}"
                             Text="No repositories yet. Add a local folder to start." />

                  <ScrollViewer MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding RepositoryPicker.Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryItemViewModel">
                          <Button Classes="list-row"
                                  Classes.current="{Binding IsCurrent}"
                                  Command="{Binding OpenCommand}"
                                  ToolTip.Tip="{Binding Path}">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                                <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <Panel Grid.Column="0" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="Check" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 IsVisible="{Binding IsCurrent}" />
                                <mi:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                 IsVisible="{Binding !IsCurrent}" />
                              </Panel>
                              <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Name}" />
                                  <TextBlock Text="(missing)" Foreground="{DynamicResource DangerBrush}"
                                             IsVisible="{Binding IsMissing}" />
                                </StackPanel>
                                <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel Spacing="2" IsVisible="{Binding HasRepository}">
                    <TextBlock Classes="caption" Text="This repository" Margin="6,2,0,2" />
                    <Button Classes="list-row" Command="{Binding OpenInEditorCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CodeBraces" Width="16" Height="16" />
                        <TextBlock Text="{Binding OpenInEditorText}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding OpenInTerminalCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Console" Width="16" Height="16" />
                        <TextBlock Text="{Binding OpenInTerminalText}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding ShowRepositoryInExplorerCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                        <TextBlock Text="Show in Explorer" />
                      </StackPanel>
                    </Button>
                    <Button Classes="list-row" Command="{Binding OpenOnGitHubCommand}" IsVisible="{Binding PullRequests.IsGitHubRepository}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Github" Width="16" Height="16" />
                        <TextBlock Text="Open on GitHub" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding RepositoryPicker.AddLocalCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" />
                        <TextBlock Text="Add local" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding CloneCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16" />
                        <TextBlock Text="Clone" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Branch dropdown: switch, new, fast-forward, rename, delete -->
          <Button x:Name="BranchButton" Classes="toolbar-dropdown" IsEnabled="{Binding HasRepository}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <mi:MaterialIcon Grid.Column="0" Kind="SourceBranch" Width="18" Height="18" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="Branch" />
                <TextBlock Classes="title" Text="{Binding BranchName}" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel x:DataType="vm:MainWindowViewModel" Width="360" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" PlaceholderText="Filter branches" Text="{Binding Branches.FilterText}" />
                    <Button Grid.Column="1" Command="{Binding Branches.NewBranchCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="SourceBranchPlus" Width="16" Height="16" />
                        <TextBlock Text="New branch" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <ScrollViewer MaxHeight="420">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="caption" Text="Local" Margin="6,4,0,2" />
                      <ItemsControl ItemsSource="{Binding Branches.Local}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LocalBranchItemViewModel">
                            <Button Classes="list-row" Classes.current="{Binding IsCurrent}" Command="{Binding SwitchCommand}"
                                    ToolTip.Tip="Click to switch. Right-click for more.">
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Switch to this branch" Command="{Binding SwitchCommand}" IsEnabled="{Binding IsNotCurrent}" />
                                  <MenuItem Header="{Binding RebaseText}" Command="{Binding RebaseOntoCommand}" IsVisible="{Binding IsNotCurrent}" />
                                  <MenuItem Header="{Binding InteractiveRebaseText}" Command="{Binding RebaseInteractivelyOntoCommand}" IsVisible="{Binding IsNotCurrent}" />
                                  <MenuItem Header="Stack a new branch on top…" Command="{Binding StackOnTopCommand}" IsVisible="{Binding IsCurrent}" />
                                  <MenuItem Header="{Binding FastForwardText}" Command="{Binding FastForwardCommand}" IsVisible="{Binding CanFastForward}" />
                                  <Separator />
                                  <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
                                  <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsNotCurrent}" />
                                </ContextMenu>
                              </Button.ContextMenu>
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Panel Grid.Column="0" Width="16">
                                  <mi:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}" />
                                  <mi:MaterialIcon Kind="SourceBranch" Width="16" Height="16" IsVisible="{Binding IsNotCurrent}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="pr-badge" IsVisible="{Binding HasPullRequest}"
                                        Classes.open="{Binding IsPullRequestOpen}" Classes.draft="{Binding IsPullRequestDraft}"
                                        Classes.merged="{Binding IsPullRequestMerged}" Classes.closed="{Binding IsPullRequestClosed}">
                                  <TextBlock Text="{Binding PullRequestBadge}" />
                                </Border>
                                <TextBlock Grid.Column="3" Classes="caption" Text="{Binding TrackingText}" VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Classes="caption" Text="On GitHub (not checked out here)" Margin="6,10,0,2"
                                 IsVisible="{Binding Branches.HasRemote}" />
                      <ItemsControl ItemsSource="{Binding Branches.Remote}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RemoteBranchItemViewModel">
                            <Button Classes="list-row" Command="{Binding CheckoutCommand}"
                                    ToolTip.Tip="Check it out as a local branch that tracks it">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="CloudOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>

                  <TextBlock Classes="caption" FontSize="11" Margin="6,4,0,0"
                             Text="Counts are from your last fetch. Right-click a branch to fast-forward, rename or delete it." TextWrapping="Wrap" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Fetch / Pull / Push. Counts come from the last fetch (fetching is manual). -->
          <Button Classes="toolbar-icon" Command="{Binding Sync.FetchCommand}" AutomationProperties.Name="Fetch"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.FetchToolTip}">
            <Panel>
              <mi:MaterialIcon Kind="Refresh" Width="20" Height="20" IsVisible="{Binding !Sync.IsFetching}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsFetching}"
                               Foreground="{DynamicResource AccentBrush}" />
            </Panel>
          </Button>

          <Button Classes="toolbar-icon" Command="{Binding Sync.PullCommand}" AutomationProperties.Name="Pull"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.PullToolTip}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Pull with rebase (default)" Command="{Binding Sync.PullCommand}" />
                <MenuItem Header="Pull with merge" Command="{Binding Sync.PullWithMergeCommand}" />
                <MenuItem Header="Fast-forward only" Command="{Binding Sync.PullFastForwardOnlyCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <Panel>
              <mi:MaterialIcon Kind="ArrowDown" Width="20" Height="20" IsVisible="{Binding !Sync.IsPulling}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsPulling}"
                               Foreground="{DynamicResource AccentBrush}" />
              <Border Classes="badge" IsVisible="{Binding Sync.HasCommitsToPull}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0">
                <TextBlock Text="{Binding Sync.CommitsToPull}" />
              </Border>
            </Panel>
          </Button>

          <!-- Push, or Publish for a branch that isn't on GitHub yet -->
          <Button Classes="toolbar-icon" Command="{Binding Sync.PushCommand}" IsVisible="{Binding Sync.IsPushVisible}" AutomationProperties.Name="Push"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Sync.PushToolTip}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Push" Command="{Binding Sync.PushCommand}" />
                <MenuItem Header="Force push (safe, with lease)…" Command="{Binding Sync.ForcePushCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <Panel>
              <mi:MaterialIcon Kind="ArrowUp" Width="20" Height="20" IsVisible="{Binding !Sync.IsPushing}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsPushing}"
                               Foreground="{DynamicResource AccentBrush}" />
              <Border Classes="badge" IsVisible="{Binding Sync.HasCommitsToPush}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0">
                <TextBlock Text="{Binding Sync.CommitsToPush}" />
              </Border>
            </Panel>
          </Button>

          <!-- Undo: click for the last move of the branch, right-click for earlier points -->
          <Button Classes="toolbar-icon" Command="{Binding Undo.UndoLastCommand}" AutomationProperties.Name="Undo"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Undo.ToolTip}">
            <Button.ContextMenu>
              <ContextMenu ItemsSource="{Binding Undo.Points}">
                <ContextMenu.Styles>
                  <Style Selector="MenuItem" x:DataType="vm:UndoPointItemViewModel">
                    <Setter Property="Header" Value="{Binding Text}" />
                    <Setter Property="Command" Value="{Binding UndoCommand}" />
                  </Style>
                </ContextMenu.Styles>
              </ContextMenu>
            </Button.ContextMenu>
            <mi:MaterialIcon Kind="UndoVariant" Width="20" Height="20" />
          </Button>

          <Button Classes="toolbar-icon" Command="{Binding Sync.PushCommand}" AutomationProperties.Name="Publish"
                  IsVisible="{Binding Sync.NeedsPublish}" ToolTip.Tip="{Binding Sync.PushToolTip}">
            <Panel>
              <mi:MaterialIcon Kind="CloudUploadOutline" Width="20" Height="20" IsVisible="{Binding !Sync.IsPushing}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding Sync.IsPushing}"
                               Foreground="{DynamicResource AccentBrush}" />
            </Panel>
          </Button>

          <!-- Pull request: create one (pushes first), or open the branch's pull request -->
          <Button Classes="toolbar-icon pr-button" Command="{Binding PullRequests.MainCommand}"
                  IsVisible="{Binding PullRequests.IsAvailable}" AutomationProperties.Name="Pull request"
                  Classes.open="{Binding PullRequests.IsOpen}" Classes.draft="{Binding PullRequests.IsDraft}"
                  Classes.merged="{Binding PullRequests.IsMerged}" Classes.closed="{Binding PullRequests.IsClosed}"
                  ToolTip.Tip="{Binding PullRequests.ToolTip}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open on GitHub" Command="{Binding PullRequests.OpenCommand}" />
                <MenuItem Header="Create pull request…" Command="{Binding PullRequests.CreateCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <!-- Plain icon: no PR yet. Colored by state (green open, gray draft, purple merged, red closed) once there is one. -->
            <Panel>
              <mi:MaterialIcon Kind="SourcePull" Width="20" Height="20" IsVisible="{Binding !PullRequests.IsBusy}" />
              <mi:MaterialIcon Kind="Loading" Width="20" Height="20" Classes="spin" IsVisible="{Binding PullRequests.IsBusy}"
                               Foreground="{DynamicResource AccentBrush}" />
            </Panel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Status bar (bottom, one line): a stopped rebase / merge / cherry-pick / revert, warnings,
         and short green notes ("Pushed 3 commits"), which hide by themselves. Green only when it's just a note. ===== -->
    <Border DockPanel.Dock="Bottom" Classes="status-bar" Classes.success="{Binding IsSuccessBar}" IsVisible="{Binding IsStatusBarVisible}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Operation.IsActive}" Margin="12,0,0,0">
          <Button Classes="status-button" Content="Abort" Command="{Binding Operation.AbortCommand}"
                  ToolTip.Tip="Cancel it and put everything back as it was" />
          <Button Classes="status-button" Content="Skip this commit" Command="{Binding Operation.SkipCommand}"
                  IsVisible="{Binding Operation.CanSkip}" ToolTip.Tip="Drop this commit's changes and go on" />
          <Button Classes="accent status-button" Content="Continue" Command="{Binding Operation.ContinueCommand}"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="Available once every conflict is resolved" />
        </StackPanel>

        <!-- A downloaded update: restart now, or it's applied on the next start -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsUpdateShown}" Margin="12,0,0,0">
          <mi:MaterialIcon Kind="Update" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock Text="{Binding Updates.ReadyText, FallbackValue=''}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
          <Button Classes="accent status-button" Content="Restart to update" Command="{Binding Updates.RestartToUpdateCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="Closes My Git, puts the new version in place and opens it again. Or keep working: it's applied next time you start My Git." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Operation.IsActive}">
          <mi:MaterialIcon Kind="SourceBranchSync" Width="14" Height="14" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="{Binding Operation.Title}" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Operation.Details}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- A short success note (when there's no warning) -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsNoticeShown}" Margin="16,0,0,0">
          <mi:MaterialIcon Kind="CheckCircleOutline" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock Text="{Binding Sync.Notice}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- The latest message, after the operation (or alone), with × to dismiss -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center" IsVisible="{Binding HasMessage}" Margin="16,0,0,0">
          <mi:MaterialIcon Grid.Column="0" Kind="AlertOutline" Width="14" Height="14" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
          <Button Grid.Column="2" Padding="3" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left"
                  Command="{Binding DismissMessageCommand}" ToolTip.Tip="Dismiss">
            <mi:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource WarningTextBrush}" />
          </Button>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ===== Content ===== -->
    <Panel>

      <!-- Empty state: no repository open -->
      <StackPanel IsVisible="{Binding !HasRepository}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" MaxWidth="380">
        <Image Source="/Assets/my-git-128.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Classes="heading" Text="Open a repository" HorizontalAlignment="Center" />
        <TextBlock Classes="caption" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Clone one of your GitHub repositories, or add a folder that's already a git repository." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Command="{Binding CloneCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16" />
              <TextBlock Text="Clone repository" />
            </StackPanel>
          </Button>
          <Button Command="{Binding RepositoryPicker.AddLocalCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" />
              <TextBlock Text="Add local repository" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Repository open: main tabs -->
      <!-- Full-width tabs on a toolbar-colored strip (the selected tab takes the content's color). -->
      <TabControl Classes="main-tabs" IsVisible="{Binding HasRepository}" Padding="0" SelectedIndex="{Binding SelectedTabIndex}">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Background="{DynamicResource ToolbarBackgroundBrush}" />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="FileDocumentEditOutline" Width="16" Height="16" />
              <TextBlock Text="Changes" VerticalAlignment="Center" />
              <Border Classes="tab-count" IsVisible="{Binding Changes.HasChangedFiles}">
                <TextBlock Text="{Binding Changes.ChangedFileCount}" />
              </Border>
            </StackPanel>
          </TabItem.Header>
          <views:ChangesView DataContext="{Binding Changes}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="History" Width="16" Height="16" />
              <TextBlock Text="History" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <views:HistoryView DataContext="{Binding History}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="LayersOutline" Width="16" Height="16" />
              <TextBlock Text="Stacks" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <views:StacksView DataContext="{Binding Stacks}" />
        </TabItem>
      </TabControl>
    </Panel>
  </DockPanel>

    <!-- ===== Command palette (Ctrl+Shift+P) ===== -->
    <Border x:Name="PaletteOverlay" Background="#73000000" IsVisible="{Binding Palette.IsOpen}">
      <Border Classes="palette" Width="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0">
        <DockPanel>
          <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Margin="10" PlaceholderText="Type a command, branch or repository…"
                   Text="{Binding Palette.Query}" />
          <ListBox x:Name="PaletteList" MaxHeight="420" ItemsSource="{Binding Palette.Items}" SelectedItem="{Binding Palette.SelectedItem}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Opacity="{Binding Opacity}">
                  <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="16" Height="16" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Classes="key" IsVisible="{Binding HasShortcut}">
                    <TextBlock Text="{Binding Right}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Right}" VerticalAlignment="Center" IsVisible="{Binding !HasShortcut}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
