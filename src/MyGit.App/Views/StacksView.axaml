<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyGit.App.ViewModels.Stacks"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MyGit.App.Views.StacksView"
             x:DataType="vm:StacksViewModel">

  <UserControl.Styles>
    <Style Selector="Border.stack-card">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    </Style>
    <Style Selector="Border.stack-card.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.stack-link">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="22,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.merged-banner">
      <Setter Property="BorderBrush" Value="{DynamicResource MergedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.restack-badge">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="240,1,*">
    <!-- Stacks list -->
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Bottom" Margin="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Command="{Binding StackOnTopCommand}" ToolTip.Tip="A new branch on top of the one you're on">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
          <TextBlock Text="Stack a branch on top" />
        </StackPanel>
      </Button>
      <DockPanel DockPanel.Dock="Top" Margin="12,6,8,2">
        <Button DockPanel.Dock="Right" Classes="header-button" Command="{Binding NewStackCommand}" ToolTip.Tip="New stack from existing branches" AutomationProperties.Name="New stack">
          <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
        </Button>
        <TextBlock Classes="caption" Text="Stacks" VerticalAlignment="Center" />
      </DockPanel>
      <Panel>
        <ListBox ItemsSource="{Binding Stacks}" SelectedItem="{Binding SelectedStack}" Background="Transparent" IsVisible="{Binding HasStacks}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StackItemViewModel">
              <StackPanel Spacing="1" Margin="2,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Summary}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="caption" Margin="14,8" TextWrapping="Wrap" IsVisible="{Binding HasNoStacks}"
                   Text="No stacks yet. Press + to make one from branches you already have, or stack a new branch on top of the one you're on. Each branch's pull request goes into the branch below it." />
      </Panel>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

    <!-- The selected stack, drawn top to bottom (newest on top, the trunk at the bottom) -->
    <DockPanel Grid.Column="2" Margin="16,10" IsVisible="{Binding HasSelection}">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Command="{Binding RestackCommand}" ToolTip.Tip="Replay the branches above a changed one onto its new version">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="LayersTripleOutline" Width="16" Height="16" />
              <TextBlock Text="Restack" />
            </StackPanel>
          </Button>
          <Button Command="{Binding CreatePullRequestsCommand}" IsVisible="{Binding IsGitHubRepository}" ToolTip.Tip="Create the missing pull requests (each into the branch below) and add the stack list to every description">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="SourcePull" Width="16" Height="16" />
              <TextBlock Text="Create PRs" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding SyncStackCommand}" IsVisible="{Binding HasMerged}"
                  ToolTip.Tip="Rebase the rest onto the trunk without the merged commits, remove the merged branches, push and update the PRs">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="SourceMerge" Width="16" Height="16" />
              <TextBlock Text="Sync stack" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding PushStackCommand}" IsVisible="{Binding !HasMerged}" ToolTip.Tip="Restack if needed, then push every branch (force with lease)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="ArrowUp" Width="16" Height="16" />
              <TextBlock Text="Push stack" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Classes="caption" Text="{Binding SelectedSubtitle}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <Border DockPanel.Dock="Top" Classes="merged-banner" IsVisible="{Binding HasMerged}" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="SourceMerge" Width="16" Height="16" Foreground="{DynamicResource MergedBrush}" VerticalAlignment="Top" />
          <TextBlock Text="{Binding MergedText}" TextWrapping="Wrap" Foreground="{DynamicResource MergedBrush}" MaxWidth="900" />
        </StackPanel>
      </Border>

      <TextBlock DockPanel.Dock="Bottom" Classes="caption" TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Hint}" />

      <ScrollViewer>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Branches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StackBranchViewModel">
                <StackPanel>
                  <Border Classes="stack-card" Classes.current="{Binding IsCurrent}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Switch to this branch" Command="{Binding SwitchCommand}" IsEnabled="{Binding IsNotCurrent}" />
                        <MenuItem Header="Open pull request on GitHub" Command="{Binding OpenPullRequestCommand}" IsEnabled="{Binding HasPullRequest}" />
                        <Separator />
                        <MenuItem Header="Take out of the stack…" Command="{Binding RemoveCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                      <Panel Grid.Column="0" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}" />
                        <mi:MaterialIcon Kind="SourceBranch" Width="16" Height="16" IsVisible="{Binding IsNotCurrent}" />
                        <mi:MaterialIcon Kind="SourceMerge" Width="16" Height="16" Foreground="{DynamicResource MergedBrush}" IsVisible="{Binding IsMerged}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Classes="pr-badge" IsVisible="{Binding HasPullRequest}"
                              Classes.open="{Binding IsPullRequestOpen}" Classes.draft="{Binding IsPullRequestDraft}"
                              Classes.merged="{Binding IsPullRequestMerged}" Classes.closed="{Binding IsPullRequestClosed}">
                        <TextBlock Text="{Binding PullRequestBadge}" />
                      </Border>
                      <TextBlock Grid.Column="2" Classes="caption" Text="no PR yet" VerticalAlignment="Center" IsVisible="{Binding HasNoPullRequest}" />
                      <Border Grid.Column="3" Classes="restack-badge" IsVisible="{Binding ShowsRestack}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource WarningTextBrush}" Text="{Binding RestackText}" />
                      </Border>
                      <Button Grid.Column="4" Classes="link" Content="Switch" Command="{Binding SwitchCommand}" IsVisible="{Binding IsNotCurrent}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Classes="stack-link" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,2,0,0">
            <mi:MaterialIcon Kind="SourceCommit" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedStack.Stack.Trunk, FallbackValue=''}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
