<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.ConfirmWindow"
        Icon="/Assets/my-git.ico"
        Width="420" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="22,20" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <mi:MaterialIcon Kind="AlertOutline" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}" />
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="MessageText" Classes="caption" FontSize="13" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="danger" />
    </StackPanel>
  </StackPanel>
</Window>
