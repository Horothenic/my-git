<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyGit.App.ViewModels.Rebase"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.InteractiveRebaseWindow"
        x:DataType="vm:InteractiveRebaseViewModel"
        Icon="/Assets/my-git.ico"
        Title="Interactive rebase"
        Width="820" Height="560" MinWidth="560" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="ListBox.rebase-rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Grid.rebase-row">
      <Setter Property="Margin" Value="8,4" />
    </Style>
    <Style Selector="Grid.rebase-row.joined">
      <Setter Property="Margin" Value="32,4,8,4" />
    </Style>
    <Style Selector="ComboBox.rebase-action">
      <Setter Property="Width" Value="92" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox.rebase-action.reword">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="ComboBox.rebase-action.joined">
      <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox.rebase-action.edit">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox.rebase-action.dropped">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.rebase-subject.dropped">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.grip">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Classes="selection-bar" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="SourceBranchSync" Width="16" Height="16" />
          <TextBlock FontWeight="SemiBold" Text="Interactive rebase" />
          <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Title}" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Oldest first, replayed top to bottom. Drag the handle or press Alt+↑/↓ to reorder. Keys: P pick · R reword · E edit · S squash · F fixup · D drop." />
        <TextBlock Classes="caption" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" IsVisible="{Binding FlattensMerges}"
                   Text="This range has merge commits. The rebase flattens them: their changes come from the commits listed here." />
      </StackPanel>
    </Border>

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Classes="selection-bar" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
          <Button Classes="accent" Content="Start rebase" Command="{Binding StartCommand}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding AutoStash}" VerticalAlignment="Center"
                  Content="Stash my uncommitted changes (new files too) and bring them back after" />
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Margin="12,6" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
               Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

    <ListBox x:Name="RowList" Classes="rebase-rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RebaseRowViewModel">
          <Grid Classes="rebase-row" Classes.joined="{Binding IsJoined}" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Grid.Column="0" Classes="grip" Padding="4,6" Margin="0,0,6,0" ToolTip.Tip="Drag to reorder">
              <mi:MaterialIcon Kind="DragVertical" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
            <ComboBox Grid.Column="1" Classes="rebase-action" VerticalAlignment="Top"
                      Classes.reword="{Binding IsReword}" Classes.joined="{Binding IsJoined}"
                      Classes.edit="{Binding IsEdit}" Classes.dropped="{Binding IsDropped}"
                      ItemsSource="{x:Static vm:RebaseRowViewModel.ActionNames}"
                      SelectedIndex="{Binding ActionIndex}" />
            <TextBlock Grid.Column="2" Margin="10,5,10,0" VerticalAlignment="Top" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Commit.ShortSha}" />
            <TextBlock Grid.Column="3" Classes="rebase-subject" Classes.dropped="{Binding IsDropped}" VerticalAlignment="Top" Margin="0,4,0,0"
                       Text="{Binding Commit.Subject}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsSubjectShown}" />
            <TextBox Grid.Column="3" Text="{Binding Message}" IsVisible="{Binding IsMessageEditable}"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="26" Padding="6,3" />
            <TextBlock Grid.Column="4" Classes="caption" Margin="10,5,4,0" VerticalAlignment="Top" Text="{Binding Hint}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
