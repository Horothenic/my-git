<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyGit.App.ViewModels.PullRequests"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyGit.App.Views.CreatePullRequestWindow"
        x:DataType="vm:CreatePullRequestViewModel"
        Icon="/Assets/my-git.ico"
        Title="Create pull request"
        Width="640" SizeToContent="Height" MinWidth="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="22,18" Spacing="6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <mi:MaterialIcon Kind="SourcePull" Width="18" Height="18" />
      <TextBlock FontWeight="SemiBold" FontSize="14" Text="Create pull request" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding Head}" />
      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="into" />
      <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" MinWidth="160" ToolTip.Tip="The branch to merge into" />
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CommitSummary}" />
    </StackPanel>

    <TextBlock Classes="caption" Text="Title" Margin="0,8,0,0" />
    <TextBox x:Name="TitleBox" Text="{Binding Title}" />

    <DockPanel Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTemplateChoice}">
        <TextBlock Classes="caption" Text="Template" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinWidth="170" />
      </StackPanel>
      <TextBlock Classes="caption" Text="Description" VerticalAlignment="Bottom" />
    </DockPanel>
    <TextBox x:Name="BodyBox" Text="{Binding Body}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
             Height="240" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
    <Button x:Name="InsertCommitsButton" Classes="link" Content="Insert commit list" HorizontalAlignment="Left" Padding="0,2"
            IsVisible="{Binding IsTemplateSelected}" ToolTip.Tip="Adds the commits where the cursor is in the description" />

    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

    <DockPanel Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Create pull request" Command="{Binding CreateCommand}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding IsDraft}" Content="Create as draft" VerticalAlignment="Center" />
    </DockPanel>
  </StackPanel>
</Window>
